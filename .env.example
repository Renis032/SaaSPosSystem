# Used by docker compose (copy to .env in the repo root if you want overrides).

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5000
FRONTEND_PORT=8080

MYSQL_DATABASE=pos
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_PORT=3306

JWT_SECRET_KEY=a-very-long-random-secret-key-that-is-at-least-32-bytes-long
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=true
SHOW_SQL=false

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_CURRENCY=usd
